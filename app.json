{
  "expo": {
    "name": "My Gym",
    "slug": "my-gym",
    "scheme": "mygym",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F14",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mygym.app0240e1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mygym.app0240e1",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "يستخدم My Gym الصور لتضع صورة لكل تمرين. تبقى الصور على جهازك.",
          "cameraPermission": "يستخدم My Gym الكاميرا لمسح باركود الأطعمة وتصوير التمارين. تبقى الصور على جهازك.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "يستخدم My Gym الكاميرا لمسح باركود الأطعمة وتصوير التمارين. تبقى الصور على جهازك.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F14"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
